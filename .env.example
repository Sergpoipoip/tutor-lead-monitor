# Copy to .env and replace placeholders locally. Never commit .env.
# For Compose URL interpolation, use independently generated hex passwords.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
POSTGRES_PORT=5432
# Host-side commands; password must match POSTGRES_APP_PASSWORD.
# Compose constructs its own URL with hostname postgres.
DATABASE_URL=postgresql+psycopg://tutor_app:REPLACE_WITH_LOCAL_APP_PASSWORD@localhost:5432/tutor_lead_monitor
CONFIG_DIR=config
LOG_LEVEL=INFO
# Telegram and provider credentials are deliberately absent in Milestone 1.
